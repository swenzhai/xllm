+  const uint32_t rotated =
+      (core + tiling.block_dim - normal % tiling.block_dim) % tiling.block_dim;
+  return partition_tasks(normal,
+                         tiling.cache_tasks_per_tensor - normal,
+                         tiling.block_dim,
+                         rotated);
+}
