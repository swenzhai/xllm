+T5QKV_MAPPING_INLINE uint32_t
+four_plane_rows(const T5SplitQkvAppendCacheTilingData& tiling) {
+  return tiling.batch * tiling.head_num == 256 && tiling.past_length == 2048 &&
+                 tiling.head_dim == 64 && tiling.block_dim == 48 &&
+                 tiling.tile_elements == 47104 &&
+                 tiling.cache_tasks_per_tensor == 768 &&
+                 tiling.cache_tiles_per_head == 3 && fuses_append(tiling) &&
+                 make_read_balance_policy(tiling).enabled
+             ? 176
+             : 0;
+}
+
+T5QKV_MAPPING_INLINE TaskRange
+four_plane_range(const T5SplitQkvAppendCacheTilingData& tiling,
+                 uint32_t phase,
+                 uint32_t core) {
+  const uint32_t normal = four_plane_rows(tiling) * tiling.cache_tiles_per_head;
+  if ((phase & 1) == 0) {
+    return partition_tasks(0, normal, tiling.block_dim, core);
