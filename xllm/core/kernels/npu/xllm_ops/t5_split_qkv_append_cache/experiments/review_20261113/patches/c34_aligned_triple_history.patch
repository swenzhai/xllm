+
+T5QKV_MAPPING_INLINE uint32_t advance_dispersed_output(uint32_t phase,
+                                                       uint32_t physical) {
+  if (phase == 0) {
+    if (physical >= kSpacedFullPeriods * 16) {
+      return physical + 1;
+    }
+    ++physical;
+    const uint32_t lane = physical % 16;
+    return physical + (lane == 4 || lane == 9 || lane == 14);
+  }
+  if (phase == 1) {
+    physical += 5;
+    return physical + (physical % 16 == 3);
+  }
+  return physical + 1;
