+
+// For a balanced 16-tile/core history, keep 15 contiguous Value tiles per
+// core and bypass its last tile. C=3 and a multiple of three cores preserve
+// exactly the same full/tail tile bytes as the original 15/16 row prefix.
+// Only phase entry changes; the inner incrementing cursor is unchanged.
+T5QKV_MAPPING_INLINE uint32_t
+read_balance_phase_task_start(const T5SplitQkvAppendCacheTilingData& tiling,
+                              uint32_t normal_value_tasks,
+                              uint32_t phase,
+                              uint32_t dense_task) {
+  if (phase == 0 || tiling.cache_tiles_per_head != 3 ||
+      tiling.block_dim % 3 != 0 ||
+      tiling.cache_tasks_per_tensor != 16 * tiling.block_dim ||
+      normal_value_tasks != 15 * tiling.block_dim) {
+    return dense_task;
+  }
+  return phase == 1 ? (dense_task / 15) * 16 + dense_task % 15
+                    : (dense_task - normal_value_tasks) * 16 + 15;
 }
 
